// Project-local debug tasks
// $ZED_WORKTREE_ROOT keeps these paths portable across local checkouts. Change
// the test path under "args" when adding a debugger for another Jest suite.
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "label": "Debug workspace-boundary tests",
    "adapter": "JavaScript",
    "type": "node",
    "request": "launch",
    "cwd": "$ZED_WORKTREE_ROOT",
    "program": "$ZED_WORKTREE_ROOT/node_modules/jest/bin/jest.js",
    "args": [
      "--runInBand",
      "--runTestsByPath",
      "$ZED_WORKTREE_ROOT/test/workspace-boundaries.test.ts"
    ],
    "sourceMaps": true,
    "smartStep": true,
    "skipFiles": [
      "<node_internals>/**",
      "$ZED_WORKTREE_ROOT/node_modules/**"
    ],
    "resolveSourceMapLocations": [
      "$ZED_WORKTREE_ROOT/**",
      "!**/node_modules/**"
    ]
  },
  {
    "label": "Attach to Jest",
    "adapter": "JavaScript",
    "type": "node",
    "request": "attach",
    "cwd": "$ZED_WORKTREE_ROOT",
    "address": "localhost",
    "port": 9229,
    "sourceMaps": true,
    "smartStep": true,
    "skipFiles": [
      "<node_internals>/**",
      "$ZED_WORKTREE_ROOT/node_modules/**"
    ],
    "resolveSourceMapLocations": [
      "$ZED_WORKTREE_ROOT/**",
      "!**/node_modules/**"
    ]
  }

]
