      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_AMP}" },
          "editorMode": "code",
          "expr": "sum(rate(graphql_operation_total{service_name=\"movie-reservation-service\",deployment_environment=\"aws-demo\"}[5m]))",
          "legendFormat": "operations/s",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "GraphQL Request Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_AMP}" },
