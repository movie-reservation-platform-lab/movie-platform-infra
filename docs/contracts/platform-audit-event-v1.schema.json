{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://movie-reservation-platform-lab.github.io/contracts/audit/platform-audit-event-v1.schema.json",
  "title": "Platform audit v1 — constrained OCSF 1.3.0 Authentication event",
  "description": "Platform subset, not the full generated OCSF schema. Field semantics are pinned to ocsf-schema 1.3.0. No optional OCSF profiles are activated.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "activity_id": {
      "const": 99
    },
    "activity_name": {
      "const": "Credential validation"
    },
    "category_uid": {
      "const": 3
    },
    "class_uid": {
      "const": 3002
    },
    "type_uid": {
      "const": 300299
    },
    "severity_id": {
      "enum": [
        1,
        2
      ]
    },
    "status_id": {
      "enum": [
        1,
        2
      ]
    },
    "status_detail": {
      "enum": [
        "INVALID_CREDENTIALS",
        "MISSING_CREDENTIALS",
        "MALFORMED_CREDENTIALS",
        "INVALID_TOKEN",
        "UNAUTHENTICATED",
        "AUTHENTICATED"
      ]
    },
    "time": {
      "type": "integer",
      "minimum": 0
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "1.3.0"
        },
        "uid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "correlation_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:/@-]+$"
        },
        "product": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "enum": [
                "movie-reservation-service",
                "movie-reservation-agent",
                "movie-recommendation-service"
              ]
            },
            "vendor_name": {
              "const": "Movie Reservation Platform Lab"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "name",
            "vendor_name",
            "version"
          ]
        }
      },
      "required": [
        "version",
        "uid",
        "correlation_uid",
        "product"
      ]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "movie-reservation-service",
            "movie-reservation-agent",
            "movie-recommendation-service"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "unknown",
            "demo-user"
          ]
        },
        "type_id": {
          "enum": [
            0,
            1
          ]
        }
      },
      "required": [
        "name",
        "type_id"
      ]
    },
    "unmapped": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": "1"
            },
            "environment": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "request_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:/@-]+$"
            },
            "trace_id": {
              "type": "string",
              "pattern": "^(?!0{32}$)[0-9a-f]{32}$"
            },
            "span_id": {
              "type": "string",
              "pattern": "^(?!0{16}$)[0-9a-f]{16}$"
            },
            "aws_alb_trace_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[\\x20-\\x7e]+$"
            },
            "aws_cloudfront_request_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[\\x20-\\x7e]+$"
            },
            "route": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^/[^?\\x00-\\x1f\\x7f]*$"
            },
            "auth_boundary": {
              "enum": [
                "demo_login",
                "graphql",
                "api_auth"
              ]
            }
          },
          "required": [
            "schema_version",
            "environment",
            "request_id",
            "route",
            "auth_boundary"
          ]
        }
      },
      "required": [
        "platform"
      ]
    }
  },
  "required": [
    "activity_id",
    "activity_name",
    "category_uid",
    "class_uid",
    "type_uid",
    "severity_id",
    "status_id",
    "status_detail",
    "time",
    "metadata",
    "service",
    "user",
    "unmapped"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status_id": {
            "const": 2
          }
        }
      },
      "then": {
        "properties": {
          "severity_id": {
            "const": 2
          },
          "user": {
            "const": {
              "name": "unknown",
              "type_id": 0
            }
          },
          "status_detail": {
            "enum": [
              "INVALID_CREDENTIALS",
              "MISSING_CREDENTIALS",
              "MALFORMED_CREDENTIALS",
              "INVALID_TOKEN",
              "UNAUTHENTICATED"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status_id": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "severity_id": {
            "const": 1
          },
          "user": {
            "const": {
              "name": "demo-user",
              "type_id": 1
            }
          },
          "status_detail": {
            "const": "AUTHENTICATED"
          }
        }
      }
    }
  ]
}
